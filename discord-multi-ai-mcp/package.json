{
  "name": "discord-multi-ai-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Discordサーバーに、メンバーそれぞれのAI（Claude / ChatGPT / Gemini / Muse など）を参加させるための共有リモートMCPサーバー（Cloudflare Workers）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
